# Copy this file to .env and fill in GROQ_API_KEY. Never commit .env.

# Groq authentication. Optional: if empty, every request uses the fallback ranker.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Settled in Phase 3 live tuning (25 calls, 5 queries): 0.2 was no more stable than 0.6, with the same
# accuracy and latency, so this follows Groq's 0.5 to 0.7 advice for reasoning models
LLM_TEMPERATURE=0.6
# Reasoning depth for gpt-oss: low, medium, or high. Settled on low: medium took 3.7 to 6.0 s per call
# (near the 6 s timeout) and used about 3x the reasoning tokens, with no accuracy gain
LLM_REASONING_EFFORT=low
# Output token cap; reasoning tokens count toward it. 1024 is enough for low effort plus 10 short
# explanations and keeps each call inside free-tier TPM (8K/min) and TPD (200K/day) for gpt-oss-120b
LLM_MAX_COMPLETION_TOKENS=1024
# Per-call timeout
LLM_TIMEOUT_SECONDS=6
# Overall time limit for the LLM step, including any retry
LLM_DEADLINE_SECONDS=8

# Candidates sent to the LLM. Equal to max top_k (10) to minimize prompt tokens on the free tier
MAX_CANDIDATES=10

# Budget tier upper bounds for cost_for_two (applied when the store loads; restart to change).
# Tuned from the cleaned dataset: p30 is 300 and p70 is 600.
# At these bounds the tiers are about 35% low, 41% medium, and 24% high.
BUDGET_LOW_MAX=300
BUDGET_MEDIUM_MAX=600

# Cleaned dataset, relative to backend/
DATA_PATH=../data/restaurants.parquet

# Allowed frontend origins (comma-separated, no trailing slash).
# Local: http://localhost:5173
# Production: add the Vercel origin, for example https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# DEBUG, INFO, WARNING, or ERROR; any other value falls back to INFO with a warning
LOG_LEVEL=INFO

# Eval tool only: the AI judge model (eval.md section 4.2). A different model family from GROQ_MODEL,
# so the judge does not favour its own writing style. The app never calls it. llama-3.3-70b-versatile,
# the model eval.md suggested, is no longer listed on Groq (checked October 2026); Qwen answers in JSON mode at temperature 0.
EVAL_JUDGE_MODEL=qwen/qwen3.8-27b
