# Leave this unset for local development. The Vite dev server proxies /api to
# http://localhost:8000, so an empty value is correct there.
#
# On Vercel, set this to the Railway API origin before the production build.
# Vite inlines it at build time. No trailing slash.
# Example: https://your-service.up.railway.app
VITE_API_BASE_URL=
